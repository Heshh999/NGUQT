{
 "schema_version": "MLES-CAPTURE-1.0.0",
 "recorder": "src/MlesV1CaptureHost.cs",
 "supersedes": "src/MofadV1MicroCaptureHost.cs (retained untouched as a MOFAD artifact)",
 "instruments": [
  "NQ",
  "ES",
  "MNQ"
 ],
 "book_type": {
  "value": "MBP",
  "meaning": "market-by-price aggregated depth",
  "prohibited_claims": [
   "queue position",
   "order identity",
   "passive fill proof"
  ]
 },
 "aggressor": {
  "raw_field": "aggrRaw",
  "raw_status": "ABSENT - feed supplies no exchange flag",
  "inferred_fields": [
   "aggrInf",
   "aggrMethod",
   "aggrConf"
  ],
  "method": "QUOTE_TEST_v1: >=ask BUY, <=bid SELL, else side of mid (LOW), mid exactly UNKNOWN/NONE",
  "rule": "raw source fields are never overwritten with derived values"
 },
 "clocks": {
  "tExch": "exchange/source time as delivered by NT8",
  "tCb": "platform callback time",
  "tRecv": "UTC receive time",
  "tMono": "local monotonic Stopwatch ticks",
  "causal_rule": "when tExch and tRecv disagree, the LATER availability time governs simulation"
 },
 "session_id": "ET session date; rolls at 18:00 ET (not UTC midnight)",
 "streams": {
  "quotes": [
   "schema",
   "runId",
   "session",
   "instrument",
   "contract",
   "stream",
   "seq",
   "tExch",
