 ],
 "manifest": {
  "file": "MLES_<inst>_<session>_manifest.json",
  "atomic": true,
  "contains": [
   "schema",
   "runId",
   "session",
   "instrument",
   "contract",
   "bookType",
   "aggressorSource",
   "firstRecvUtc",
   "lastRecvUtc",
   "rows",
   "quality",
   "sha256 per file"
  ]
 },
 "append_only": true,
 "derived_features": "separate versioned files with parent hashes - NEVER written by the recorder",
 "outcome_fields_prohibited": [
